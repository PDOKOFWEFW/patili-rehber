---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Buradaki Props tanımı Markdown'daki heroImage'ı yakalar
type Props = CollectionEntry<'blog'>['data'];

const { title, description, heroImage } = Astro.props;
---

<html lang="tr">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body style="background-color: #f9fafb;">
		<Header />
		<main style="max-width: 800px; margin: 0 auto; padding: 20px;">
			<article>
				<div class="hero-image" style="margin-bottom: 2rem;">
					{heroImage && (
						<img 
							src={heroImage} 
							alt={title} 
							style="width: 100%; border-radius: 20px; box-shadow: 0 10px 15px rgba(0,0,0,0.1); object-fit: cover; max-height: 400px;" 
						/>
					)}
				</div>
				
				<div class="prose">
					<h1 style="font-size: 2.5rem; color: #111827;">{title}</h1>
					<hr style="margin: 2rem 0;" />
					<slot /> </div>
			</article>
		</main>
		<Footer />
	</body>
</html>