---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Bakım ile ilgili anahtar kelimeleri buraya ekliyoruz
const bakimTerimleri = ['bakim', 'sampuan', 'firca', 'tirnak', 'kum', 'temizleme', 'yikama', 'hijyen'];

const posts = (await getCollection('blog')).filter(post => 
    bakimTerimleri.some(terim => post.data.title.toLowerCase().includes(terim)) ||
    post.data.description.toLowerCase().includes('bakım')
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Evcil Hayvan Bakım Ürünleri - ${SITE_TITLE}`} description="En iyi kedi ve köpek bakım ürünleri, şampuanlar ve hijyen malzemeleri incelemeleri." />
		<style>
			.container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
			.post-list { list-style: none; padding: 0; }
			.post-card { 
				display: flex; gap: 20px; background: white; border-radius: 15px; padding: 15px; 
				margin-bottom: 20px; border: 1px solid #eee; text-decoration: none; color: inherit;
				align-items: center; transition: transform 0.2s;
			}
			.post-card:hover { transform: scale(1.02); }
			.post-card img { width: 150px; height: 100px; object-fit: cover; border-radius: 10px; }
			h1 { color: #ea580c; margin-bottom: 30px; }
		</style>
	</head>
	<body>
		<Header />
		<main class="container">
			<h1>Bakım & Hijyen Ürünleri</h1>
			<p>{posts.length} adet bakım ürünü incelemesi bulundu.</p>
			
			<div class="post-list">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-card">
						<img src={post.data.heroImage} alt="" />
						<div>
							<h2 style="font-size: 1.2rem; margin: 0;">{post.data.title}</h2>
							<p style="font-size: 0.9rem; color: #666; margin: 5px 0 0;">{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>