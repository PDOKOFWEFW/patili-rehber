---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const KURUMSAL_LOGO = "/logo.png";
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Arşiv | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; font-family: system-ui, sans-serif; }
			.post-card { 
				display: flex; gap: 30px; background: white; border-radius: 24px; padding: 24px; 
				border: 1px solid #f3f4f6; text-decoration: none; color: inherit; align-items: center;
				margin-bottom: 30px; transition: all 0.3s ease; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
			}
			.post-card:hover { transform: translateY(-5px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1); }
			.post-image { width: 280px; height: 180px; object-fit: contain; background: #f8fafc; border-radius: 16px; flex-shrink: 0; }
			.post-content h2 { margin: 10px 0; color: #111827; font-size: 1.5rem; font-weight: bold; }
			@media (max-width: 768px) {
				.post-card { flex-direction: column; }
				.post-image { width: 100%; }
			}
		</style>
	</head>
	<body style="background-color: #f9fafb;">
		<Header />
		<main class="container">
			<h1 style="font-size: 2.5rem; margin-bottom: 40px;">Tüm İncelemeler</h1>
			<section>
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-card">
						<img src={KURUMSAL_LOGO} alt={post.data.title} class="post-image" />
						<div class="post-content">
							<FormattedDate date={post.data.pubDate} />
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</div>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>