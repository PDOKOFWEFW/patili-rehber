---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; // Veya senin ana layoutun

const posts = (await getCollection('blog')).filter(post => 
    post.data.title.toLowerCase().includes('kedi')
);
---
<main>
    <h1>Kedi Ürünleri İncelemeleri</h1>
    <ul>
        {posts.map(post => (
            <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
        ))}
    </ul>
</main>